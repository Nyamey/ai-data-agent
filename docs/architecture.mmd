%% Workflow de l'agent ai-data-agent (LangGraph) -- reflète les arêtes
%% réelles de agent/graph.py (build_agent_graph). Rendu automatiquement
%% par GitHub dans un bloc ```mermaid
flowchart TD
    A[1. Cadrage<br/>métrique · question testable] --> B[2. Inspection<br/>schéma · qualité des données]
    B -->|en attente d'approbation| C{3. Approbation<br/>validation humaine}
    B -->|erreur| X[Fin<br/>rejet ou erreur]
    C -->|rejeté| X
    C -->|approuvé| D[4. Construction<br/>métrique via DuckDB]
    D --> E[5. Test<br/>facteurs explicatifs]
    E --> F[6. Validation<br/>cohérence · reproductibilité]
    F --> G[7. Recommandations<br/>classées par impact / faisabilité]
    G --> H[8. Export<br/>Excel · PowerPoint]
    H --> Y[Fin<br/>analyse terminée]
    Y -.->|optionnel, hors du graphe LangGraph| Z[Chat de suivi<br/>interroge DuckDB en direct si besoin]

    classDef step fill:#eef2ff,stroke:#6366f1,color:#0f172a;
    classDef human fill:#fef3c7,stroke:#f59e0b,color:#0f172a;
    classDef term fill:#f1f5f9,stroke:#94a3b8,color:#0f172a;
    classDef extra fill:#ecfdf5,stroke:#10b981,color:#0f172a,stroke-dasharray: 4 3;
    class A,B,D,E,F,G,H step;
    class C human;
    class X,Y term;
    class Z extra;
