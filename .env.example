# Copiez ce fichier en .env et remplissez avec au moins une clé API

GROQ_API_KEY=gsk_votre_cle_ici
GOOGLE_API_KEY=votre_cle_ici
OPENROUTER_API_KEY=sk-or_votre_cle_ici
MISTRAL_API_KEY=votre_cle_ici

# Provider utilisé par défaut si aucun n'est précisé explicitement (groq,
# gemini, openrouter ou mistral) -- voir agent/llm/config.py
DEFAULT_LLM_PROVIDER=groq

# Chemin DuckDB par défaut (utilisé par le serveur MCP et l'agent CLI ;
# l'app Streamlit utilise ses propres fichiers par session)
DUCKDB_PATH=./data/analytics.duckdb
